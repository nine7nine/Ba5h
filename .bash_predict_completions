# bash_predict_completions -- Register -W wordlists for inline prediction.
#
# Source this from ~/.bashrc BEFORE bash-completion loads.
# The completion predictor reads -W wordlists for instant suggestions.
#
# bash-completion will typically override these with -F specs for
# interactive tab-completion, but the predictor caches the -W words
# at registration time.  If bash-completion clobbers them, move
# this to source AFTER bash-completion and use:
#   complete -o default -W "words..." cmd
# or register with -W alongside -F:
#   complete -F _git -W "add bisect blame ..." git

